{
    "name": "onair",
    "buildpacks": [
        {
            "url": "heroku/nodejs"
        }
    ],
    "healthchecks": {
        "web": [
            {
                "type": "startup",
                "name": "web check",
                "description": "Checking if the app responds to the /health endpoint",
                "path": "/health",
                "attempts": 3
            }
        ]
    },
    "formation": {
        "web": {
            "quantity": 2,
            "max_parallel": 2
        },
        "worker": {
            "quantity": 1
        }
    }
}